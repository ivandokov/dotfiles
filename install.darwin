#!/usr/bin/env bash
#
# macOS installer. Run it through ./install rather than directly.

set -u

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
source "$DOTFILES/lib/dotfiles.sh"

export PATH=/opt/homebrew/bin:$PATH

sudo -v

# Keep-alive: update existing `sudo` time stamp until installation has finished
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

# Install rosetta
if [[ $(uname -m) == 'arm64' ]]; then
    softwareupdate --install-rosetta --agree-to-license
fi

# Install brew
if test ! "$(which brew)"; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
fi

# Update Homebrew recipes
brew update

# Install all our dependencies with bundle (See Brewfile)
brew tap homebrew/bundle
brew bundle --file="$DOTFILES/Brewfile"

touch "$HOME/.hushlogin"

# Install crontab entries
crontab "$DOTFILES/crontab"

# Install LaunchAgents (symlinked so repo edits take effect, then bootstrapped)
mkdir -p "$HOME/Library/LaunchAgents"
for plist in "$DOTFILES"/launchagents/*.plist; do
    [ -f "$plist" ] || continue
    label=$(basename "$plist" .plist)
    ln -sfn "$plist" "$HOME/Library/LaunchAgents/$label.plist"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
    launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/$label.plist"
done

# Create a Code directory
mkdir -p "$HOME/Code"

# Convenience symlink for the iCloud Drive root (used by tmux.conf for tmux-resurrect)
ln -sfn "$HOME/Library/Mobile Documents/com~apple~CloudDocs" "$HOME/iCloud"

# Symlink the Mackup config file to the home directory
ln -sfn "$DOTFILES/mackup.cfg" "$HOME/.mackup.cfg"

# Install custom Mackup application definitions
mkdir -p "$HOME/.mackup"
for cfg in "$DOTFILES"/mackup/*.cfg; do
    [ -f "$cfg" ] && ln -sfn "$cfg" "$HOME/.mackup/$(basename "$cfg")"
done

dotfiles_oh_my_zsh

echo "Shell configuration:"
dotfiles_link "$DOTFILES/zsh/zshrc" "$HOME/.zshrc"
dotfiles_link "$DOTFILES/nvim" "$HOME/.config/nvim"

# Setup global gitignore
git config --global core.excludesfile ~/.gitignore

# Install Depy
chown "$USER" /opt
git clone https://github.com/ivandokov/depy.git /opt/depy
cd /opt/depy || exit 1
./install
