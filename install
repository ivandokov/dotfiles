#!/usr/bin/env bash
#
# Entry point. Picks the installer for this operating system and hands over to
# it. Everything shared between them lives in lib/dotfiles.sh.

set -u

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES

case "$(uname -s)" in
    Darwin) exec "$DOTFILES/install.darwin" "$@" ;;
    Linux)  exec "$DOTFILES/install.linux" "$@" ;;
    *)      echo "No installer for $(uname -s)." >&2; exit 1 ;;
esac
