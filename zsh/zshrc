# Cross platform zsh configuration.
#
# This file holds everything that is true on every machine. Anything that only
# makes sense on one operating system lives in zshrc.darwin or zshrc.linux,
# which is sourced below, and in zsh/custom/os/<os>/*.zsh, which oh-my-zsh
# picks up through zsh/custom/zz-os.zsh.

export DOTFILES="$HOME/.dotfiles"

case "$OSTYPE" in
    darwin*) export DOTFILES_OS="darwin" ;;
    linux*)  export DOTFILES_OS="linux" ;;
    *)       export DOTFILES_OS="unknown" ;;
esac

# Keep path and fpath free of duplicates. Repeated entries are easy to collect
# when several tools each prepend themselves on every shell start.
typeset -U path fpath

# Relative entries come first so a project's own binaries win over globally
# installed ones (artisan, phpunit, vite and friends).
path=(
    .
    ./vendor/bin
    ./node_modules/.bin
    $HOME/.local/bin
    $HOME/.composer/vendor/bin
    $path
)

# Operating system specific PATH, fpath and environment. Sourced before
# oh-my-zsh so additions to fpath are in place when compinit runs below.
[ -r "$DOTFILES/zsh/zshrc.$DOTFILES_OS" ] && source "$DOTFILES/zsh/zshrc.$DOTFILES_OS"

# TERM has to be settled before oh-my-zsh loads: its title and cwd support
# inspects TERM once, at source time, and silently does nothing for a value it
# does not recognise.
#
# A terminal that describes itself as something more capable than xterm
# (Ghostty, Alacritty, kitty, WezTerm) is left alone, because overriding it
# costs truecolor and keybindings. The exception is a TERM with no terminfo
# entry on this machine, which is worse than a plain one: zsh then comes up
# without its zle hooks.
if [ -z "$TERM" ] || [ "$TERM" = dumb ] || [ "$TERM" = xterm ] \
   || ! infocmp "$TERM" > /dev/null 2>&1; then
    export TERM=xterm-256color
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_CUSTOM=$DOTFILES/zsh/custom
ZSH_THEME="dokov"

plugins=(git laravel composer)

source $ZSH/oh-my-zsh.sh

HIST_STAMPS="dd/mm/yyyy"
export HISTSIZE=32768
export HISTFILESIZE=$HISTSIZE
export HISTCONTROL=ignoredups
export HISTIGNORE="ls:cd:cd -:pwd:date:* --help"
export HISTORY_IGNORE="(ls|cd|cd -|pwd|date|* --help)"
export LANG=en_US.UTF-8
export EDITOR=nano

autoload -Uz compinit
compinit

command -v zoxide > /dev/null && eval "$(zoxide init zsh)"

# bun, which installs to the same place on both platforms.
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && path=("$BUN_INSTALL/bin" $path)
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# Note for the future: installers that "inject" shell configuration (Herd,
# Docker Desktop, bun, nvm) append to ~/.zshrc, which is a symlink to this
# file. Move anything macOS specific that turns up below into zshrc.darwin.
